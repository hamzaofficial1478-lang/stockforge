# ---------------------------------------------------------------------------
# Vision model. Anything OpenAI-compatible: NVIDIA NIM, vLLM, Ollama, LM Studio.
# Nothing here is billed by anyone if you run it on your own card.
# ---------------------------------------------------------------------------
SF_VISION_BASE_URL=http://localhost:8000/v1
SF_VISION_MODEL=nvidia/llama-3.2-90b-vision-instruct
# SF_VISION_API_KEY=            # only for hosted endpoints
SF_VISION_MAX_EDGE=1280
SF_VISION_TIMEOUT=300

# Optional smaller text-only model for keywords and copy. Falls back to vision.
# SF_REASON_BASE_URL=http://localhost:8001/v1
# SF_REASON_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# Etsy. An API key from etsy.com/developers turns the shop crawler from
# fragile page-parsing into a reliable listing feed, and answers "how many
# uploads do I actually have" in one call.
# ---------------------------------------------------------------------------
# SF_ETSY_API_KEY=

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
SF_ROOT=./workspace
SF_FONTS=./assets/fonts
SF_MOTIFS=./assets/motifs

# ---------------------------------------------------------------------------
# Derivation — how far a new design moves from the one it learned from.
# Low values produce near-copies, which agencies match against and reject.
# ---------------------------------------------------------------------------
SF_DERIVE_STRENGTH=0.5
SF_DISTINCT_THRESHOLD=0.70
SF_DERIVE_ROUNDS=2
SF_CRITIQUE_ROUNDS=2

# ---------------------------------------------------------------------------
# Publishing. Off by default. Turning it on still cannot publish a design
# whose provenance check failed — that gate is in the code, not here.
# ---------------------------------------------------------------------------
SF_PUBLISH=0
# SF_FTP_ADOBE_HOST=ftp.contributor.adobestock.com
# SF_FTP_ADOBE_USER=
# SF_FTP_ADOBE_PASS=
# SF_FTP_SHUTTERSTOCK_HOST=ftp.shutterstock.com
# SF_FTP_SHUTTERSTOCK_USER=
# SF_FTP_SHUTTERSTOCK_PASS=
