# ---------------------------------------------------------------------------
# Vision model. Anything OpenAI-compatible: NVIDIA NIM, vLLM, Ollama, LM Studio.
# Nothing here is billed by anyone if you run it on your own card.
# ---------------------------------------------------------------------------
SF_VISION_BASE_URL=http://localhost:8000/v1
SF_VISION_MODEL=nvidia/llama-3.2-90b-vision-instruct
# SF_VISION_API_KEY=            # only for hosted endpoints
SF_VISION_MAX_EDGE=1280
SF_VISION_TIMEOUT=300

# Optional smaller text-only model for keywords and copy. Falls back to vision.
# SF_REASON_BASE_URL=http://localhost:8001/v1
# SF_REASON_MODEL=qwen2.5:14b
# SF_REASON_API_KEY=            # only for hosted endpoints

# ---------------------------------------------------------------------------
# Etsy. An API key from etsy.com/developers turns the shop crawler from
# fragile page-parsing into a reliable listing feed, and answers "how many
# uploads do I actually have" in one call.
# ---------------------------------------------------------------------------
# SF_ETSY_API_KEY=

# How patient the crawler is. A long pull meets a rate limit and a bad gateway
# whatever time of day it starts; these decide how long it waits before giving
# up on one request. A 404 is never retried.
SF_HTTP_RETRIES=4
SF_HTTP_BACKOFF=2.0

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
SF_ROOT=./workspace
SF_FONTS=./assets/fonts
SF_MOTIFS=./assets/motifs
# Optional OCR executable override. Windows also searches its install folders
# and tools/tesseract/tesseract.exe beside this repository.
# SF_TESSERACT=C:/Program Files/Tesseract-OCR/tesseract.exe

# Recover the original by default; 0 enables the variation controls below.
SF_PRESERVE_ORIGINAL=1

# ---------------------------------------------------------------------------
# Making a new design. SF_MIX borrows ingredients from your OTHER designs —
# grid from one, palette from another, decoration from a third — so the result
# has no single original. SF_DERIVE_STRENGTH then moves that result further
# on its own. Both are sliders on the Setup screen of the control panel.
# ---------------------------------------------------------------------------
SF_MIX=0.5
SF_DERIVE_STRENGTH=0.5
SF_DISTINCT_THRESHOLD=0.70
SF_DERIVE_ROUNDS=2
SF_CRITIQUE_ROUNDS=2

# How close a library motif must be before it is placed. Higher means more
# designs go to review with a description of what to draw; lower means you
# start shipping approximate decoration. A hole is the cheaper mistake.
SF_MOTIF_THRESHOLD=0.45

# How alike two finished pages may be before one is held back, in bits of a
# 256-bit perceptual hash. Measured on real output: the same file re-encoded is
# 0, the same page recoloured is 4, genuinely different designs sit 40 to 74
# apart. Raise it to catch more and send more to review.
SF_DUPLICATE_DISTANCE=20

# ---------------------------------------------------------------------------
# Delivery. Off by default.
#
# The provenance pass flags designs that lean on third-party library content
# or photographic artwork; by default those stop at an editable master.
# SF_PUBLISH_ALL=1 sends them anyway. The flag and its reason stay recorded on
# every design either way, so you can always see what went out.
# ---------------------------------------------------------------------------
SF_PUBLISH=0
SF_PUBLISH_ALL=0
# SF_FTP_ADOBE_HOST=ftp.contributor.adobestock.com
# SF_FTP_ADOBE_USER=
# SF_FTP_ADOBE_PASS=
# SF_FTP_SHUTTERSTOCK_HOST=ftp.shutterstock.com
# SF_FTP_SHUTTERSTOCK_USER=
# SF_FTP_SHUTTERSTOCK_PASS=

# ---------------------------------------------------------------------------
# The rest of the levers. All have working defaults; none of these need
# setting to run. They were readable by the code and written down nowhere,
# which is the same as not existing.
# ---------------------------------------------------------------------------
# How good a rebuild has to score before it ships without a second look, and
# how bad before it stops being worth another round and goes to a human.
# SF_SHIP_THRESHOLD=0.85
# SF_ESCALATE_THRESHOLD=0.60

# The long edge of the preview JPEG, in pixels. The preview is what the
# duplicate check compares, so lowering it makes that check coarser.
# SF_PREVIEW_PX=1400

# Read settings from somewhere other than ./.env
# SF_ENV_FILE=/path/to/.env

# Where Inkscape is, if it is not on PATH and not in the usual Windows install
# folder. Only needed for an unusual location.
# SF_INKSCAPE=C:\Program Files\Inkscape\bin\inkscape.exe
