# Anthropic API. `ant auth login` works too — the SDK finds the profile.
ANTHROPIC_API_KEY=

# Paths
SF_ROOT=./workspace
SF_FONTS=./assets/fonts
SF_MOTIFS=./assets/motifs

# Model. Opus 5 is the default on purpose: a weak read costs more in critique
# rounds and human review than it saves in tokens. Drop to claude-sonnet-5 only
# after you have measured the difference on your own designs.
SF_MODEL=claude-opus-5
SF_EFFORT=high

# Loop
SF_CRITIQUE_ROUNDS=3
SF_SHIP_THRESHOLD=0.88
SF_ESCALATE_THRESHOLD=0.62

# Hard spend stop, USD per day
SF_DAILY_USD_CAP=40
