# ---------------------------------------------------------------------------
# Vision model. Anything OpenAI-compatible: NVIDIA NIM, vLLM, Ollama, LM Studio.
# Nothing here is billed by anyone if you run it on your own card.
# ---------------------------------------------------------------------------
SF_VISION_BASE_URL=http://localhost:8000/v1
SF_VISION_MODEL=nvidia/llama-3.2-90b-vision-instruct
# SF_VISION_API_KEY=            # only for hosted endpoints
SF_VISION_MAX_EDGE=1280
# Hosted endpoints cap how big an inline image may be. NVIDIA's is 180 kB and
# going over it comes back as a 500 that says nothing about size, so images are
# encoded down to fit rather than sent and rejected.
SF_VISION_MAX_IMAGE_BYTES=180000
# How long a model may send nothing at all before the design is handed to the
# next live one. Requests are streamed, so this measures silence on the wire —
# it is not a cap on how long the model may think. One that keeps answering is
# never cut off, however long the card takes it. Set 0 or SF_VISION_STREAM=0 to
# go back to one timeout on the whole call.
SF_VISION_SILENCE=120
# How many of the reading questions to have in the air at once. Four covers a
# single-page card exactly — palette, provenance, type, structure — which is the
# common case, and they depend on nothing but the survey so there is no reason
# to ask them one at a time. It is a cap rather than a target: a twelve-page
# wedding suite would otherwise open twenty-six connections at once and get
# rate limited for it. Set 1 to go back to one question at a time.
SF_VISION_CONCURRENCY=4

# ---------------------------------------------------------------------------
# Which niche you are working on
# ---------------------------------------------------------------------------
# Halloween cards and business cards are not the same catalogue, and a palette
# borrowed across that line is a mistake everybody notices. Everything pulled in
# or made is filed under this, donors only ever come from inside it, and the
# finished files land in out/<niche>/. Set from the Sources screen or with
# `stockforge niche "Halloween cards"`; kept here so it survives a restart.
# SF_COLLECTION=halloween-cards
# How many designs a niche needs before it can be mixed from. Below this there
# are so few combinations that a run repeats itself whatever the ledger does.
SF_SEED_DESIGNS=24
# The fewest other designs a single variation will try to borrow from. Lower
# than the batch's twenty-four because one design at a time is a smaller ask —
# but not one, which cannot work at all: with a single donor every ingredient
# comes from the same place and the result is the original with its hue nudged.
# Below this the recovered master is made instead, with the reason on it.
SF_LEAST_DONORS=4

# ---------------------------------------------------------------------------
# A smaller model for the easy questions
# ---------------------------------------------------------------------------
# Three of the five reading passes do not need a big model. The palette is
# already measured off the pixels and only its roles need naming; provenance is
# "is any of this a photograph"; the survey is "which of these images are
# pages". Point these at something small and fast and the two hard passes —
# type and structure — set the pace instead of the sum of all five. Leave them
# unset and the reading model does all of it, as before.
# SF_QUICK_BASE_URL=http://localhost:11434/v1
# SF_QUICK_MODEL=llama3.2-vision
# SF_QUICK_API_KEY=
# Which backend talks to it, if not an OpenAI-compatible server.
# SF_QUICK_BACKEND=openai

# ---------------------------------------------------------------------------
# Drawing the motifs your library has not got
# ---------------------------------------------------------------------------
# Decoration the analyser found in your own designs that nothing in the library
# matches. Harvesting cuts those out of your artwork where they exist; this is
# for the ones that do not. Reference to trace, never a deliverable — the files
# land in assets/motifs/_drawn/ with a note beside each, and the library scan
# only ever reads *.svg, so a generated picture cannot be placed in a design.
# Qwen's image models work; the address is theirs.
# SF_IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# SF_IMAGE_MODEL=qwen-image
# SF_IMAGE_API_KEY=
# Pixels down each side.
# SF_IMAGE_SIZE=1024
# A 500 from a hosted endpoint is usually the endpoint, not you. Retry, then
# send a smaller request, before giving up on the design.
SF_VISION_RETRIES=2
# Which backend talks to the model. Two ship with the program:
#
#   openai   anything speaking OpenAI's chat shape — Ollama, vLLM, NIM,
#            LM Studio, OpenAI itself, OpenRouter, Together, Groq. GPT, Hermes,
#            Qwen, Llama and the rest are MODELS you run on one of those, set
#            with SF_VISION_MODEL above — not backends.
#   claude   Anthropic's own API (see below).
#
# For anything speaking a different shape — Gemini, Bedrock, your own endpoint —
# write a module with a BACKEND in it and put its import path here instead:
#
#   SF_VISION_BACKEND=my_package.my_backend
#
# Nothing in stockforge needs changing. docs/backends.md has a working example.
SF_VISION_BACKEND=openai

# ---------------------------------------------------------------------------
# Drawing artwork the motif library has no answer for. A third role, separate
# from the two above because it is a different job: these models make pictures
# rather than read them, and they answer with an image where a chat model
# answers with words. Testing one as though it were a chat model reports "an
# odd reply" even though the call succeeded.
#
# On QwenCloud the OpenAI-compatible address serves image models too:
#   SF_IMAGE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   SF_IMAGE_MODEL=qwen-image-3.0
#   SF_IMAGE_API_KEY=sk-...
# ---------------------------------------------------------------------------
# SF_IMAGE_BASE_URL=
# SF_IMAGE_MODEL=
# SF_IMAGE_API_KEY=
# SF_IMAGE_BACKEND=openai

# ---------------------------------------------------------------------------
# Using Claude instead of running a model yourself.
#
# Set the backend to claude and sign in once:
#
#     ant auth login
#
# That opens a browser and stores the result, so nothing is pasted in here and
# no key is kept in the workspace. ANTHROPIC_API_KEY works instead if you would
# rather use one.
#
# Be clear-eyed about it: this is a paid API billed to your Anthropic account.
# It is not the same thing as a Claude.ai chat subscription, and signing in
# rather than pasting a key removes the key handling, not the bill. The local
# model above stays the default and costs nothing to run.
#
#     pip install anthropic
#     SF_VISION_BACKEND=claude
#     SF_VISION_MODEL=claude-opus-5
#     SF_VISION_EFFORT=low        # low | medium | high | xhigh | max
# ---------------------------------------------------------------------------
SF_VISION_TIMEOUT=300
# Response tokens include reasoning; a truncated reply is retried once with more room.
SF_VISION_MAX_TOKENS=4096

# Optional smaller text-only model for keywords and copy. Falls back to vision.
# Takes the same backend/effort settings as the vision role.
# SF_REASON_BASE_URL=http://localhost:8001/v1
# SF_REASON_MODEL=qwen2.5:14b
# SF_REASON_BACKEND=openai
# SF_REASON_EFFORT=low
# SF_REASON_API_KEY=            # only for hosted endpoints

# ---------------------------------------------------------------------------
# Etsy. An API key from etsy.com/developers turns the shop crawler from
# fragile page-parsing into a reliable listing feed, and answers "how many
# uploads do I actually have" in one call.
# ---------------------------------------------------------------------------
# SF_ETSY_API_KEY=

# How patient the crawler is. A long pull meets a rate limit and a bad gateway
# whatever time of day it starts; these decide how long it waits before giving
# up on one request. A 404 is never retried.
SF_HTTP_RETRIES=4
SF_HTTP_BACKOFF=2.0

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
SF_ROOT=./workspace
SF_FONTS=./assets/fonts
SF_MOTIFS=./assets/motifs
# Optional OCR executable override. Windows also searches its install folders
# and tools/tesseract/tesseract.exe beside this repository.
# SF_TESSERACT=C:/Program Files/Tesseract-OCR/tesseract.exe

# Recover the original by default; 0 enables the variation controls below.
SF_PRESERVE_ORIGINAL=1

# ---------------------------------------------------------------------------
# Making a new design. SF_MIX borrows ingredients from your OTHER designs —
# grid from one, palette from another, decoration from a third — so the result
# has no single original. SF_DERIVE_STRENGTH then moves that result further
# on its own. Both are sliders on the Setup screen of the control panel.
# ---------------------------------------------------------------------------
SF_MIX=0.5
SF_DERIVE_STRENGTH=0.5
SF_DISTINCT_THRESHOLD=0.70
SF_DERIVE_ROUNDS=2
SF_CRITIQUE_ROUNDS=2

# How close a library motif must be before it is placed. Higher means more
# designs go to review with a description of what to draw; lower means you
# start shipping approximate decoration. A hole is the cheaper mistake.
SF_MOTIF_THRESHOLD=0.45

# How alike two finished pages may be before one is held back, in bits of a
# 256-bit perceptual hash. Measured on real output: the same file re-encoded is
# 0, the same page recoloured is 4, genuinely different designs sit 40 to 74
# apart. Raise it to catch more and send more to review.
SF_DUPLICATE_DISTANCE=20

# ---------------------------------------------------------------------------
# Delivery. Off by default.
#
# The provenance pass flags designs that lean on third-party library content
# or photographic artwork; by default those stop at an editable master.
# SF_PUBLISH_ALL=1 sends them anyway. The flag and its reason stay recorded on
# every design either way, so you can always see what went out.
# ---------------------------------------------------------------------------
# How much of a surface may be placed photograph before the program stops
# calling it a rebuild and sends it to you instead. A design read as one big
# photographic area comes back as the original picture with the text set beside
# it — which is not a recovered design, however finished it looks.
# How many designs to build at once. One is a design at a time with a breather
# between, which is what it has always done. More than one runs that same loop
# side by side, each lane on its own vision model from the Models list — so
# raise this only when you have a second model for them to use, or the lanes
# will simply queue behind the same server and nothing gets faster.
SF_WORKERS=1

SF_MAX_RASTER=0.40

SF_PUBLISH=0
SF_PUBLISH_ALL=0
# SF_FTP_ADOBE_HOST=ftp.contributor.adobestock.com
# SF_FTP_ADOBE_USER=
# SF_FTP_ADOBE_PASS=
# SF_FTP_SHUTTERSTOCK_HOST=ftp.shutterstock.com
# SF_FTP_SHUTTERSTOCK_USER=
# SF_FTP_SHUTTERSTOCK_PASS=

# ---------------------------------------------------------------------------
# The rest of the levers. All have working defaults; none of these need
# setting to run. They were readable by the code and written down nowhere,
# which is the same as not existing.
# ---------------------------------------------------------------------------
# How good a rebuild has to score before it ships without a second look, and
# how bad before it stops being worth another round and goes to a human.
# SF_SHIP_THRESHOLD=0.85
# SF_ESCALATE_THRESHOLD=0.60

# The long edge of the preview JPEG, in pixels. The preview is what the
# duplicate check compares, so lowering it makes that check coarser.
# SF_PREVIEW_PX=1400

# Read settings from somewhere other than the .env this finds for itself.
# With nothing set, the program looks for a .env in this folder and every
# folder above it, so running from a sub-folder or a shortcut finds the same
# settings as running from the checkout.
# SF_ENV_FILE=/path/to/.env

# Anything the control panel can write is taken from the file even when the
# same variable is already exported, because the panel is where you set it —
# one stray SF_MIX in a system environment used to beat the saved value on
# every start, silently. Set this to 1 for the usual rule, where an exported
# variable wins, if you want to override a saved setting for a single run.
# SF_ENV_OVERRIDE=0

# Where Inkscape is, if it is not on PATH and not in the usual Windows install
# folder. Only needed for an unusual location.
# SF_INKSCAPE=C:\Program Files\Inkscape\bin\inkscape.exe
